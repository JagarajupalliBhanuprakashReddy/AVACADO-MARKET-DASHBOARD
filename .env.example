# ==============================================================================
# AGRICULTURAL MARKET PRICING & SALES DASHBOARD - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure with your credentials.
# ==============================================================================

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agricultural_market_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_POOL_NAME=agri_pool
DB_POOL_SIZE=10

# AI / Ollama Service Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=15

# Application Settings
APP_ENV=development
APP_TITLE=Agricultural Market Pricing & Sales Dashboard
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
